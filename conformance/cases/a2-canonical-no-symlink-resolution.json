{
  "id": "a2-canonical-no-symlink-resolution",
  "description": "a link at the canonical path is not resolved",
  "spec": [
    "A2 Canonical path"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "symlink",
      "target": "/data/work"
    },
    "/data/work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "canonical_path",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "path": "/home/p/.claude-work"
    }
  }
}
