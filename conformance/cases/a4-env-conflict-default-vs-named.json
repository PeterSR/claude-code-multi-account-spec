{
  "id": "a4-env-conflict-default-vs-named",
  "description": "CONFIG_DIR=$HOME/.claude means default, MULTI=work disagrees",
  "spec": [
    "A4 Step 1.2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_CONFIG_DIR": "/home/p/.claude",
    "CLAUDE_MULTI_ACCOUNT": "work"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "error": {
      "code": "ENV_CONFLICT",
      "path": null
    }
  }
}
