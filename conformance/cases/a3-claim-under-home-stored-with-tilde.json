{
  "id": "a3-claim-under-home-stored-with-tilde",
  "description": "an absolute directory under home is stored as ~/...",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1}"
    },
    "/home/p/dev/personal": {
      "type": "dir"
    }
  },
  "op": {
    "name": "claim",
    "args": {
      "name": "work",
      "dir": "/home/p/dev/personal"
    }
  },
  "expect": {
    "result": {
      "directories": [
        "~/dev/personal"
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1,
        "directories": [
          "~/dev/personal"
        ]
      },
      "mode": "0600"
    },
    "/home/p/.claude-work/.multi-account.json.lock": null
  }
}
