{
  "id": "a2-create-case-variant-cs-ok",
  "description": "case-sensitive fs: .claude-Work does not block create(work)",
  "spec": [
    "A2 Create"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-Work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "create",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "name": "work",
      "configDir": "/home/p/.claude-work"
    }
  },
  "expectFs": {
    "/home/p/.claude-work": {
      "type": "dir",
      "mode": "0700"
    },
    "/home/p/.claude-Work": {
      "type": "dir"
    }
  }
}
