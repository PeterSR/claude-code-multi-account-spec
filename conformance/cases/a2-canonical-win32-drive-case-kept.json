{
  "id": "a2-canonical-win32-drive-case-kept",
  "description": "win32 keeps the drive letter case as given",
  "spec": [
    "A2 Canonical path"
  ],
  "platform": "win32",
  "caseInsensitive": true,
  "home": "c:\\Users\\p",
  "cwd": "c:\\Users\\p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {},
  "op": {
    "name": "canonical_path",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "path": "c:\\Users\\p\\.claude-work"
    }
  }
}
