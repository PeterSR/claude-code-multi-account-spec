{
  "id": "b7-slot-managed-dangling-json-link",
  "description": "a dangling ~/.claude.json link with the right target is managed (Claude Code creates it through the link)",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "slot",
    "args": {}
  },
  "expect": {
    "result": {
      "state": "managed",
      "name": "work"
    }
  }
}
