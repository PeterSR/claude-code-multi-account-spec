{
  "id": "a4-map-resolved-target-account-is-link",
  "description": "row 5: the account dir is a link, V is the real target",
  "spec": [
    "A4 Step 1 mapping"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "symlink",
      "target": "/data/real"
    },
    "/data/real": {
      "type": "dir"
    }
  },
  "op": {
    "name": "map_config_dir",
    "args": {
      "value": "/data/real"
    }
  },
  "expect": {
    "result": {
      "account": "work",
      "canonical": false,
      "reason": "resolved-target",
      "warnings": [
        "NON_CANONICAL_CONFIG_DIR"
      ]
    }
  }
}
