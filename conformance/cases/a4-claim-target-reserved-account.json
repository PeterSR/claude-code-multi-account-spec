{
  "id": "a4-claim-target-reserved-account",
  "description": "a claim by a reserved-name account resolves with RESERVED_NAME",
  "spec": [
    "A2 Names"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p/dev",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-profiles/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"directories\": [\"~/dev\"]}"
    },
    "/home/p/dev": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "profiles",
      "pool": null,
      "configDir": "/home/p/.claude-profiles",
      "canonical": true,
      "reason": null,
      "source": "claim",
      "matchedPath": "/home/p/dev",
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_CONFIG_DIR": "/home/p/.claude-profiles",
          "CLAUDE_MULTI_ACCOUNT": "profiles"
        },
        "unset": [
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [],
      "warnings": [
        "RESERVED_NAME"
      ],
      "applied": true,
      "candidates": [
        "profiles"
      ],
      "globalConfig": "/home/p/.claude-profiles/.claude.json"
    }
  }
}
