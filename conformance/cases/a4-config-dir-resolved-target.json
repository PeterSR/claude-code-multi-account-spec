{
  "id": "a4-config-dir-resolved-target",
  "description": "a link elsewhere to an account dir",
  "spec": [
    "A4 Step 1 mapping"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_CONFIG_DIR": "/data/wlink"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/data/wlink": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "work",
      "pool": null,
      "configDir": "/data/wlink",
      "canonical": false,
      "reason": "resolved-target",
      "source": "config-dir",
      "matchedPath": null,
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_CONFIG_DIR": "/home/p/.claude-work",
          "CLAUDE_MULTI_ACCOUNT": "work"
        },
        "unset": [
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [],
      "warnings": [
        "NON_CANONICAL_CONFIG_DIR"
      ],
      "applied": true,
      "candidates": [
        "work"
      ],
      "globalConfig": "/data/wlink/.claude.json"
    }
  }
}
