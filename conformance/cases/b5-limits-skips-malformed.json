{
  "id": "b5-limits-skips-malformed",
  "description": "junk and entries without a window or a readable until are left out",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": [\"x\", {\"until\": \"2026-10-09T14:00:00Z\"}, {\"window\": \"a\", \"until\": \"soon\"}, {\"window\": \"w\", \"until\": \"2026-10-09T14:00:00Z\"}]}"
    }
  },
  "op": {
    "name": "limits",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "limits": [
        {
          "window": "w",
          "model": null,
          "until": "2026-10-09T14:00:00Z",
          "reason": null,
          "updatedBy": null,
          "updatedAt": null
        }
      ]
    }
  }
}
