{
  "id": "a4-git-ceiling-at-repo-root",
  "description": "ceiling at the repo root still sees its .git",
  "spec": [
    "A4 Step 2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p/dev/repo",
  "env": {},
  "options": {
    "ceilingDirs": [
      "/home/p/dev/repo"
    ]
  },
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/dev/repo/.git": {
      "type": "dir"
    },
    "/home/p/dev/repo/.claude-account": {
      "type": "file",
      "content": "work\n"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "default",
      "pool": null,
      "configDir": "/home/p/.claude",
      "canonical": true,
      "reason": null,
      "source": "default",
      "matchedPath": null,
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_MULTI_ACCOUNT": "default"
        },
        "unset": [
          "CLAUDE_CONFIG_DIR",
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [
        "/home/p/dev/repo/.claude-account"
      ],
      "warnings": [
        "MARKER_IGNORED_IN_REPO"
      ],
      "applied": true,
      "candidates": [
        "default"
      ],
      "globalConfig": "/home/p/.claude.json"
    }
  }
}
