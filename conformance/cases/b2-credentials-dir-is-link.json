{
  "id": "b2-credentials-dir-is-link",
  "description": "a link on the account directory is fine",
  "spec": [
    "B2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "symlink",
      "target": "/data/w"
    },
    "/data/w/.credentials.json": {
      "type": "file",
      "content": "{\"claudeAiOauth\": {\"accessToken\": \"at-1\", \"refreshToken\": \"rt-SECRET\", \"expiresAt\": 1791306000000, \"scopes\": [\"user:inference\", \"user:profile\"], \"subscriptionType\": \"max\", \"rateLimitTier\": \"default_claude_max_5x\"}}"
    }
  },
  "op": {
    "name": "credentials",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "source": "file",
      "path": "/home/p/.claude-work/.credentials.json",
      "accessToken": "at-1",
      "expiresAt": "2026-10-06T17:00:00.000Z",
      "expired": false,
      "scopes": [
        "user:inference",
        "user:profile"
      ],
      "subscriptionType": "max",
      "rateLimitTier": "default_claude_max_5x"
    }
  }
}
