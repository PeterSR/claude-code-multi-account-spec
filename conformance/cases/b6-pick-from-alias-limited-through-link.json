{
  "id": "b6-pick-from-alias-limited-through-link",
  "description": "default shares the slot account state, so a limited work makes default unavailable",
  "spec": [
    "B6",
    "A2 Relocation"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-personal": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": [{\"window\": \"five_hour\", \"model\": null, \"until\": \"2026-10-09T14:00:00Z\", \"reason\": \"rate_limit\", \"updatedBy\": \"x\", \"updatedAt\": \"2026-10-01T00:00:00Z\"}]}",
      "mode": "0600"
    }
  },
  "op": {
    "name": "pick_from",
    "args": {
      "candidates": [
        "default",
        "personal"
      ]
    }
  },
  "expect": {
    "result": {
      "account": "personal"
    }
  }
}
