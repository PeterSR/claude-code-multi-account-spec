{
  "id": "a3-claim-via-default-writes-slot-account-file",
  "description": "claiming for default while the slot holds work writes work spec file",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/srv/b": {
      "type": "dir"
    }
  },
  "op": {
    "name": "claim",
    "args": {
      "name": "default",
      "dir": "/srv/b"
    }
  },
  "expect": {
    "result": {
      "directories": [
        "/srv/b"
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1,
        "directories": [
          "/srv/b"
        ]
      }
    }
  }
}
