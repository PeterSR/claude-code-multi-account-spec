{
  "id": "b2-usage-stale-exactly-one-hour",
  "description": "an age of exactly one hour is still fresh",
  "spec": [
    "B2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{\"cachedUsageUtilization\": {\"utilization\": {}, \"fetchedAtMs\": 1791284400000}}"
    }
  },
  "op": {
    "name": "usage",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "fetchedAt": "2026-10-06T11:00:00.000Z",
      "data": {
        "utilization": {},
        "fetchedAtMs": 1791284400000
      },
      "windows": {},
      "stale": false
    }
  }
}
