{
  "id": "a2-canonical-home-dotdot",
  "description": "home with .. is normalised lexically, symlinks never resolved",
  "spec": [
    "A2 Canonical path"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p/../q",
  "cwd": "/home/p/../q",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {},
  "op": {
    "name": "canonical_path",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "path": "/home/q/.claude-work"
    }
  }
}
