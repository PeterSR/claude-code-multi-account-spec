{
  "id": "a2-create-basic",
  "description": "create makes the dir 0700 and a minimal spec file 0600",
  "spec": [
    "A2 Create",
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "create",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "name": "work",
      "configDir": "/home/p/.claude-work"
    }
  },
  "expectFs": {
    "/home/p/.claude-work": {
      "type": "dir",
      "mode": "0700"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "mode": "0600",
      "contentJson": {
        "version": 1,
        "createdAt": "2026-10-06T12:00:00Z"
      }
    },
    "/home/p/.claude-work/.multi-account.json.lock": null
  }
}
