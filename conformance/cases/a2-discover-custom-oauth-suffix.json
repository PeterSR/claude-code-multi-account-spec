{
  "id": "a2-discover-custom-oauth-suffix",
  "description": "CLAUDE_CODE_CUSTOM_OAUTH_URL changes the global config name",
  "spec": [
    "A1"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_CODE_CUSTOM_OAUTH_URL": "https://example.test"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-b/.claude-custom-oauth.json": {
      "type": "file",
      "content": "{}"
    }
  },
  "op": {
    "name": "discover",
    "args": {}
  },
  "expect": {
    "result": {
      "accounts": [
        {
          "name": "default",
          "configDir": "/home/p/.claude",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "a",
          "configDir": "/home/p/.claude-a",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "b",
          "configDir": "/home/p/.claude-b",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": true,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        }
      ],
      "conflicts": [],
      "warnings": []
    }
  }
}
