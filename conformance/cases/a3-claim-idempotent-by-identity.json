{
  "id": "a3-claim-idempotent-by-identity",
  "description": "another spelling of the same directory is already claimed",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"directories\": [\"/srv/alink\"]}"
    },
    "/srv/alink": {
      "type": "symlink",
      "target": "/srv/a"
    },
    "/srv/a": {
      "type": "dir"
    }
  },
  "op": {
    "name": "claim",
    "args": {
      "name": "work",
      "dir": "/srv/a"
    }
  },
  "expect": {
    "result": {
      "directories": [
        "/srv/alink"
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1,
        "directories": [
          "/srv/alink"
        ]
      }
    }
  }
}
