{
  "id": "b2-usage-stale-one-hour-and-a-millisecond",
  "description": "older than one hour is stale",
  "spec": [
    "B2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{\"cachedUsageUtilization\": {\"utilization\": {}, \"fetchedAtMs\": 1791284399999}}"
    }
  },
  "op": {
    "name": "usage",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "fetchedAt": "2026-10-06T10:59:59.999Z",
      "data": {
        "utilization": {},
        "fetchedAtMs": 1791284399999
      },
      "windows": {},
      "stale": true
    }
  }
}
