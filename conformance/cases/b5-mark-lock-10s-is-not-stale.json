{
  "id": "b5-mark-lock-10s-is-not-stale",
  "description": "a lock exactly 10 s old is not older than 10 s",
  "spec": [
    "A3 File safety rules"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json.lock": {
      "type": "dir",
      "mtime": "2026-10-06T11:59:50Z"
    }
  },
  "op": {
    "name": "mark_limited",
    "args": {
      "name": "work",
      "entry": {
        "window": "seven_day",
        "model": "opus",
        "until": "2026-10-09T14:00:00Z",
        "reason": "rate_limit",
        "updatedBy": "my-swapper"
      }
    }
  },
  "expect": {
    "error": {
      "code": "LOCK_BUSY",
      "path": "/home/p/.claude-work/.multi-account-state.json.lock"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account-state.json.lock": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": null
  }
}
