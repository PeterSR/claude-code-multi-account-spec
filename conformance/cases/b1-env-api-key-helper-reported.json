{
  "id": "b1-env-api-key-helper-reported",
  "description": "apiKeyHelper from settings.json is reported",
  "spec": [
    "B1"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/settings.json": {
      "type": "file",
      "content": "{\"apiKeyHelper\": \"/bin/k\"}"
    }
  },
  "op": {
    "name": "env",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "set": {
        "CLAUDE_CONFIG_DIR": "/home/p/.claude-work",
        "CLAUDE_MULTI_ACCOUNT": "work"
      },
      "unset": [
        "CLAUDE_MULTI_ACCOUNT_SOURCE",
        "CLAUDE_SECURESTORAGE_CONFIG_DIR"
      ],
      "overriddenBy": [
        "apiKeyHelper"
      ]
    }
  }
}
