{
  "id": "b1-cred-win32-credman-env",
  "description": "FORCE_WINDOWS_CREDMAN=1 puts Credential Manager first",
  "spec": [
    "B1",
    "A1",
    "A2 Canonical path"
  ],
  "platform": "win32",
  "caseInsensitive": true,
  "home": "C:\\Users\\p",
  "cwd": "C:\\Users\\p",
  "env": {
    "CLAUDE_CODE_FORCE_WINDOWS_CREDMAN": "1"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "C:\\Users\\p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "credential_locations",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "locations": [
        {
          "credentialManager": {}
        },
        {
          "file": "C:\\Users\\p\\.claude-work\\.credentials.json"
        }
      ]
    }
  }
}
