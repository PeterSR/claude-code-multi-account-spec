{
  "id": "b7-adopt-unsupported-darwin",
  "description": "adopt refuses on darwin and changes nothing",
  "spec": [
    "B7"
  ],
  "platform": "darwin",
  "caseInsensitive": true,
  "home": "/Users/p",
  "cwd": "/Users/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/Users/p": {
      "type": "dir"
    },
    "/Users/p/.claude": {
      "type": "dir"
    },
    "/Users/p/.claude/.credentials.json": {
      "type": "file",
      "content": "cred"
    },
    "/Users/p/.claude.json": {
      "type": "file",
      "content": "{\"a\":1}"
    }
  },
  "op": {
    "name": "adopt",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "error": {
      "code": "SLOT_UNSUPPORTED",
      "path": null
    }
  },
  "expectFs": {
    "/Users/p/.claude": {
      "type": "dir"
    },
    "/Users/p/.claude-work": null,
    "/Users/p/.claude.json": {
      "type": "file"
    }
  }
}
