{
  "id": "a2-canonical-win32",
  "description": "canonical path on win32 uses backslashes",
  "spec": [
    "A2 Canonical path"
  ],
  "platform": "win32",
  "caseInsensitive": true,
  "home": "C:\\Users\\p",
  "cwd": "C:\\Users\\p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "C:\\Users\\p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "canonical_path",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "path": "C:\\Users\\p\\.claude-work"
    }
  }
}
