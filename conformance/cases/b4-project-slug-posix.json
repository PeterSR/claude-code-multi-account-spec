{
  "id": "b4-project-slug-posix",
  "description": "every character outside [a-zA-Z0-9] becomes a hyphen",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "project_slug",
    "args": {
      "cwd": "/home/user/dev/my_proj.v2"
    }
  },
  "expect": {
    "result": {
      "slug": "-home-user-dev-my-proj-v2"
    }
  }
}
