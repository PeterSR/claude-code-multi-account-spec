{
  "id": "b5-mark-preserves-foreign-entries-verbatim",
  "description": "entries written by others keep every key; nothing is added or removed",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": [{\"window\": \"weekly\", \"model\": null, \"until\": \"2026-10-09T14:00:00Z\", \"note\": \"from another tool\"}, \"junk\"]}"
    }
  },
  "op": {
    "name": "mark_limited",
    "args": {
      "name": "work",
      "entry": {
        "window": "seven_day",
        "model": "opus",
        "until": "2026-10-09T14:00:00Z",
        "reason": "rate_limit",
        "updatedBy": "my-swapper"
      }
    }
  },
  "expect": {
    "result": {
      "limits": [
        {
          "window": "weekly",
          "model": null,
          "until": "2026-10-09T14:00:00Z",
          "note": "from another tool"
        },
        "junk",
        {
          "window": "seven_day",
          "model": "opus",
          "until": "2026-10-09T14:00:00Z",
          "reason": "rate_limit",
          "updatedBy": "my-swapper",
          "updatedAt": "2026-10-06T12:00:00Z"
        }
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account-state.json": {
      "contentJson": {
        "version": 1,
        "limits": [
          {
            "window": "weekly",
            "model": null,
            "until": "2026-10-09T14:00:00Z",
            "note": "from another tool"
          },
          "junk",
          {
            "window": "seven_day",
            "model": "opus",
            "until": "2026-10-09T14:00:00Z",
            "reason": "rate_limit",
            "updatedBy": "my-swapper",
            "updatedAt": "2026-10-06T12:00:00Z"
          }
        ]
      }
    }
  }
}
