{
  "id": "b3-sorted-numerically",
  "description": "sorted by numeric pid",
  "spec": [
    "B3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/sessions/100.json": {
      "type": "file",
      "content": "{\"pid\": 100, \"sessionId\": \"s-100\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    },
    "/home/p/.claude-work/sessions/9.json": {
      "type": "file",
      "content": "{\"pid\": 9, \"sessionId\": \"s-9\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    },
    "/home/p/.claude-work/sessions/10.json": {
      "type": "file",
      "content": "{\"pid\": 10, \"sessionId\": \"s-10\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    }
  },
  "processes": {
    "10": {
      "procStart": "T1",
      "pidDomain": "host-1"
    }
  },
  "op": {
    "name": "live_sessions",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "sessions": [
        {
          "pid": 9,
          "sessionId": "s-9",
          "status": "dead"
        },
        {
          "pid": 10,
          "sessionId": "s-10",
          "status": "live"
        },
        {
          "pid": 100,
          "sessionId": "s-100",
          "status": "dead"
        }
      ]
    }
  }
}
