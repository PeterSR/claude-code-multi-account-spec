{
  "id": "a2-create-reserved-later-list",
  "description": "reservation uses the case-supplied list",
  "spec": [
    "A2 Names"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "reserved": [
    "default",
    "legacy"
  ],
  "op": {
    "name": "create",
    "args": {
      "name": "legacy"
    }
  },
  "expect": {
    "error": {
      "code": "RESERVED_NAME",
      "path": null
    }
  }
}
