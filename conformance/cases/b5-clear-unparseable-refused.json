{
  "id": "b5-clear-unparseable-refused",
  "description": "clear on an unparseable state file is refused",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "content": "nope"
    }
  },
  "op": {
    "name": "clear_limited",
    "args": {
      "name": "work",
      "window": "seven_day",
      "model": "opus"
    }
  },
  "expect": {
    "error": {
      "code": "STATE_FILE_INVALID",
      "path": "/home/p/.claude-work/.multi-account-state.json"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account-state.json": {
      "content": "nope"
    },
    "/home/p/.claude-work/.multi-account-state.json.lock": null
  }
}
