{
  "id": "b3-session-of-pid-follows-record",
  "description": "the record is read as it is now (the id changes on /clear)",
  "spec": [
    "B3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/sessions/4242.json": {
      "type": "file",
      "content": "{\"pid\": 4242, \"sessionId\": \"new-id\", \"cwd\": \"/home/p/proj\", \"startedAt\": 1759752000000, \"version\": \"2.1.292\", \"kind\": \"interactive\", \"entrypoint\": \"cli\", \"status\": \"idle\", \"updatedAt\": 1759752100000, \"pidDomain\": \"linux:11111111111111111111111111111111:pid:[1234567890]\", \"procStart\": \"12345678\"}"
    }
  },
  "op": {
    "name": "session_of_pid",
    "args": {
      "name": "work",
      "pid": 4242
    }
  },
  "expect": {
    "result": {
      "sessionId": "new-id"
    }
  }
}
