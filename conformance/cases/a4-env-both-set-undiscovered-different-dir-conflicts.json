{
  "id": "a4-env-both-set-undiscovered-different-dir-conflicts",
  "description": "a foreign directory plus a missing account is a conflict",
  "spec": [
    "A4 Step 1.2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_CONFIG_DIR": "/opt/x",
    "CLAUDE_MULTI_ACCOUNT": "work"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
