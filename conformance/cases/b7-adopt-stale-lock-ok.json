{
  "id": "b7-adopt-stale-lock-ok",
  "description": "a stale slot lock is taken over by adopt",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "dir"
    },
    "/home/p/.claude/.credentials.json": {
      "type": "file",
      "content": "cred"
    },
    "/home/p/.claude.json": {
      "type": "file",
      "content": "{\"a\":1}"
    },
    "/home/p/.claude-slot.lock": {
      "type": "dir",
      "mtime": "2026-10-06T11:00:00Z"
    }
  },
  "op": {
    "name": "adopt",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "state": "managed",
      "name": "work"
    }
  },
  "expectFs": {
    "/home/p/.claude-slot.lock": null
  }
}
