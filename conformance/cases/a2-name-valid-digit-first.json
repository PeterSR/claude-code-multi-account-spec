{
  "id": "a2-name-valid-digit-first",
  "description": "valid name '1x_y-z'",
  "spec": [
    "A2 Names"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "canonical_path",
    "args": {
      "name": "1x_y-z"
    }
  },
  "expect": {
    "result": {
      "path": "/home/p/.claude-1x_y-z"
    }
  }
}
