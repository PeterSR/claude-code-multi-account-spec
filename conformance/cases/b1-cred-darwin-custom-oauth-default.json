{
  "id": "b1-cred-darwin-custom-oauth-default",
  "description": "darwin default with custom oauth suffix",
  "spec": [
    "B1",
    "A1",
    "A2 Canonical path"
  ],
  "platform": "darwin",
  "caseInsensitive": true,
  "home": "/Users/p",
  "cwd": "/Users/p",
  "env": {
    "USER": "user",
    "CLAUDE_CODE_CUSTOM_OAUTH_URL": "x"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/Users/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "credential_locations",
    "args": {
      "name": "default"
    }
  },
  "expect": {
    "result": {
      "locations": [
        {
          "keychain": {
            "service": "Claude Code-custom-oauth-credentials",
            "account": "user"
          }
        },
        {
          "file": "/Users/p/.claude/.credentials.json"
        }
      ]
    }
  }
}
