{
  "id": "a2-canonical-darwin",
  "description": "canonical path on darwin",
  "spec": [
    "A2 Canonical path"
  ],
  "platform": "darwin",
  "caseInsensitive": true,
  "home": "/Users/p",
  "cwd": "/Users/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/Users/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "canonical_path",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "path": "/Users/p/.claude-work"
    }
  }
}
