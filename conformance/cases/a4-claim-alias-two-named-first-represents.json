      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_CONFIG_DIR": "/home/p/.claude-a",
          "CLAUDE_MULTI_ACCOUNT": "a"
        },
        "unset": [
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [],
      "warnings": [],
      "applied": true,
      "candidates": [
        "a"
      ],
      "globalConfig": "/home/p/.claude-a/.claude.json"
    }
  }
