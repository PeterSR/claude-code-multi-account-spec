{
  "id": "a4-claim-alias-two-named-first-represents",
  "description": "two named links to one dir: the first name claims, no conflict",
  "spec": [
    "A2 Relocation",
    "A4 Step 2.2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p/dev",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
