{
  "id": "a3-claim-own-invalid-spec-file",
  "description": "the account own invalid file is never overwritten",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{"
    }
  },
  "op": {
    "name": "claim",
    "args": {
      "name": "work",
      "dir": "/srv/a"
    }
  },
  "expect": {
    "error": {
      "code": "SPEC_FILE_INVALID",
      "path": "/home/p/.claude-work/.multi-account.json"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "content": "{"
    }
  }
}
