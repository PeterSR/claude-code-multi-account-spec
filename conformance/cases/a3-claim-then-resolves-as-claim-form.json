{
  "id": "a3-claim-then-resolves-as-claim-form",
  "description": "the stored form is what resolve reads: ~/ entries are valid claims",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"directories\": [\"~/dev\"]}"
    },
    "/home/p/dev/a": {
      "type": "dir"
    },
    "/home/p/dev": {
      "type": "dir"
    }
  },
  "op": {
    "name": "claim",
    "args": {
      "name": "work",
      "dir": "/home/p/dev/a"
    }
  },
  "expect": {
    "result": {
      "directories": [
        "~/dev",
        "~/dev/a"
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1,
        "directories": [
          "~/dev",
          "~/dev/a"
        ]
      }
    }
  }
}
