{
  "id": "a3-update-spec-file-default",
  "description": "default writes ~/.claude/.multi-account.json",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "dir"
    }
  },
  "op": {
    "name": "update_spec_file",
    "args": {
      "name": "default",
      "patch": {
        "label": "D"
      }
    }
  },
  "expect": {
    "result": {
      "version": 1,
      "label": "D"
    }
  },
  "expectFs": {
    "/home/p/.claude/.multi-account.json": {
      "contentJson": {
        "version": 1,
        "label": "D"
      },
      "mode": "0600"
    }
  }
