{
  "id": "b4-handover-default-and-slot-account-same",
  "description": "default and the slot account are the same account",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-work/tasks/sess-1/t.json": {
      "type": "file",
      "content": "{}"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "default",
      "to": "work",
      "overwrite": true
    }
  },
  "expect": {
    "error": {
      "code": "SAME_ACCOUNT",
      "path": null
    }
  }
}
