{
  "id": "a2-discover-marker-file-in-home",
  "description": "~/.claude-account as a file is a marker, not an account",
  "spec": [
    "A2 Discovery",
    "A4 Marker parsing"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-account": {
      "type": "file",
      "content": "work\n"
    }
  },
  "op": {
    "name": "discover",
    "args": {}
  },
  "expect": {
    "result": {
      "accounts": [
        {
          "name": "default",
          "configDir": "/home/p/.claude",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        }
      ],
      "conflicts": [],
      "warnings": [
        "NOT_A_DIRECTORY"
      ]
    }
  }
}
