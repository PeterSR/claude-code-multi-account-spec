{
  "id": "b7-activate-credentials-link-refused",
  "description": "a target with a linked .credentials.json is refused",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-personal/.claude.json": {
      "type": "file",
      "content": "{\"p\":1}"
    },
    "/home/p/.claude-work/.credentials.json": {
      "type": "file",
      "content": "wc"
    },
    "/home/p/.claude-personal/.credentials.json": {
      "type": "symlink",
      "target": "/data/c"
    },
    "/data/c": {
      "type": "file",
      "content": "c"
    }
  },
  "op": {
    "name": "activate",
    "args": {
      "name": "personal"
    }
  },
  "expect": {
    "error": {
      "code": "SLOT_TARGET_INVALID",
      "path": "/home/p/.claude-personal/.credentials.json"
    }
  },
  "expectFs": {
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude-slot.lock": null
  }
}
