{
  "id": "b5-mark-default-account",
  "description": "default keeps state in ~/.claude",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "dir"
    }
  },
  "op": {
    "name": "mark_limited",
    "args": {
      "name": "default",
      "entry": {
        "window": "seven_day",
        "model": "opus",
        "until": "2026-10-09T14:00:00Z",
        "reason": "rate_limit",
        "updatedBy": "my-swapper"
      }
    }
  },
  "expect": {
    "result": {
      "limits": [
        {
          "window": "seven_day",
          "model": "opus",
          "until": "2026-10-09T14:00:00Z",
          "reason": "rate_limit",
          "updatedBy": "my-swapper",
          "updatedAt": "2026-10-06T12:00:00Z"
        }
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude/.multi-account-state.json": {
      "type": "file",
      "mode": "0600"
    }
  }
}
