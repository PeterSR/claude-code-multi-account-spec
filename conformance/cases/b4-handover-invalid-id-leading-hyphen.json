{
  "id": "b4-handover-invalid-id-leading-hyphen",
  "description": "session id '-x' is INVALID_SESSION_ID",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/projects/-home-p-x/sess-1.jsonl": {
      "type": "file",
      "content": "line1\nline2\n",
      "mode": "0600"
    },
    "/home/p/.claude-a/projects/-home-p-x/sess-1/subagents/a.jsonl": {
      "type": "file",
      "content": "sub",
      "mode": "0600"
    },
    "/home/p/.claude-a/projects/-home-p-x/sess-1/tool-results/r.txt": {
      "type": "file",
      "content": "res",
      "mode": "0644"
    },
    "/home/p/.claude-a/file-history/sess-1/v1": {
      "type": "file",
      "content": "hist",
      "mode": "0600"
    },
    "/home/p/.claude-a/session-env/sess-1/env.sh": {
      "type": "file",
      "content": "export A=1",
      "mode": "0600"
    },
    "/home/p/.claude-a/tasks/sess-1/t.json": {
      "type": "file",
      "content": "{}",
      "mode": "0600"
    },
    "/home/p/.claude-a/projects/-home-p-x/other.jsonl": {
      "type": "file",
      "content": "not this one"
    },
    "/home/p/.claude-a/projects/-home-p-y": {
      "type": "dir"
    },
    "/home/p/.claude-a/tasks/other-id/t.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-a/.credentials.json": {
      "type": "file",
      "content": "wc"
    },
    "/home/p/.claude-b/.credentials.json": {
      "type": "file",
      "content": "pc"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "-x",
      "from": "a",
      "to": "b",
      "overwrite": true
    }
  },
  "expect": {
    "error": {
      "code": "INVALID_SESSION_ID",
      "path": null
    }
  },
  "expectFs": {
    "/home/p/.claude-b/.credentials.json": {
      "type": "file",
      "content": "pc"
    },
    "/home/p/.claude-a/.credentials.json": {
      "type": "file",
      "content": "wc"
    }
  }
}
