{
  "id": "b5-mark-different-window-is-its-own-key",
  "description": "a different window is a different key",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": [{\"window\": \"seven_day\", \"model\": \"opus\", \"until\": \"2026-10-09T14:00:00Z\", \"reason\": \"rate_limit\", \"updatedBy\": \"old\", \"updatedAt\": \"2026-10-01T00:00:00Z\"}]}",
      "mode": "0600"
    }
  },
  "op": {
    "name": "mark_limited",
    "args": {
      "name": "work",
      "entry": {
        "window": "five_hour",
        "model": "opus",
        "until": "2026-10-09T14:00:00Z",
        "reason": "rate_limit",
        "updatedBy": "my-swapper"
      }
    }
  },
  "expect": {
    "result": {
      "limits": [
        {
          "window": "seven_day",
          "model": "opus",
          "until": "2026-10-09T14:00:00Z",
          "reason": "rate_limit",
          "updatedBy": "old",
          "updatedAt": "2026-10-01T00:00:00Z"
        },
        {
          "window": "five_hour",
          "model": "opus",
          "until": "2026-10-09T14:00:00Z",
          "reason": "rate_limit",
          "updatedBy": "my-swapper",
          "updatedAt": "2026-10-06T12:00:00Z"
        }
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "mode": "0600",
      "contentJson": {
        "version": 1,
        "limits": [
          {
            "window": "seven_day",
            "model": "opus",
            "until": "2026-10-09T14:00:00Z",
            "reason": "rate_limit",
            "updatedBy": "old",
            "updatedAt": "2026-10-01T00:00:00Z"
          },
          {
            "window": "five_hour",
            "model": "opus",
            "until": "2026-10-09T14:00:00Z",
            "reason": "rate_limit",
            "updatedBy": "my-swapper",
