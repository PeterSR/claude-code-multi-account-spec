{
  "id": "b7-adopt-inner-claude-json-only-ok",
  "description": "only the inner .claude.json exists: it stays and the link points at it",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude/.claude.json": {
      "type": "file",
      "content": "{\"inner\":1}"
    }
  },
  "op": {
    "name": "adopt",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "state": "managed",
      "name": "work"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.claude.json": {
      "content": "{\"inner\":1}"
    }
  }
}
