{
  "id": "b4-handover-destination-file-parent-blocked",
  "description": "a regular file where a destination parent should be blocks too",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/tasks/sess-1/t.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-b/tasks": {
      "type": "file",
      "content": "x"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "a",
      "to": "b"
    }
  },
  "expect": {
    "error": {
      "code": "DESTINATION_BLOCKED",
      "path": "/home/p/.claude-b/tasks"
    }
  }
}
