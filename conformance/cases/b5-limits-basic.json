{
  "id": "b5-limits-basic",
  "description": "limits returns the parsed entries as stored, past ones included",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": [{\"window\": \"seven_day\", \"model\": \"opus\", \"until\": \"2026-10-09T14:00:00Z\", \"reason\": \"rate_limit\", \"updatedBy\": \"my-swapper\", \"updatedAt\": \"2026-10-01T00:00:00Z\"}, {\"window\": \"five_hour\", \"until\": \"2026-10-01T00:00:00Z\"}]}",
      "mode": "0600"
    }
  },
  "op": {
    "name": "limits",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "limits": [
        {
          "window": "seven_day",
          "model": "opus",
          "until": "2026-10-09T14:00:00Z",
          "reason": "rate_limit",
          "updatedBy": "my-swapper",
          "updatedAt": "2026-10-01T00:00:00Z"
        },
        {
          "window": "five_hour",
          "model": null,
          "until": "2026-10-01T00:00:00Z",
          "reason": null,
          "updatedBy": null,
          "updatedAt": null
        }
      ]
    }
  }
}
