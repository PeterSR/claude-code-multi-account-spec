{
  "id": "b2-credentials-no-expiry",
  "description": "no expiresAt: not expired, expiresAt null",
  "spec": [
    "B2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.credentials.json": {
      "type": "file",
      "content": "{\"claudeAiOauth\": {\"accessToken\": \"at-1\"}}"
    }
  },
  "op": {
    "name": "credentials",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "source": "file",
      "path": "/home/p/.claude-work/.credentials.json",
      "accessToken": "at-1",
      "expiresAt": null,
      "expired": false,
      "scopes": [],
      "subscriptionType": null,
      "rateLimitTier": null
    }
  }
}
