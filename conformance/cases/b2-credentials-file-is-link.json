{
  "id": "b2-credentials-file-is-link",
  "description": "a link at .credentials.json is unreadable to claude, so null",
  "spec": [
    "B2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.credentials.json": {
      "type": "symlink",
      "target": "/data/c.json"
    },
    "/data/c.json": {
      "type": "file",
      "content": "{\"claudeAiOauth\": {\"accessToken\": \"at-1\", \"refreshToken\": \"rt-SECRET\", \"expiresAt\": 1791306000000, \"scopes\": [\"user:inference\", \"user:profile\"], \"subscriptionType\": \"max\", \"rateLimitTier\": \"default_claude_max_5x\"}}"
    }
  },
  "op": {
    "name": "credentials",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": null
  }
}
