{
  "id": "b2-usage-stale-future-fetch",
  "description": "a fetch time in the future is stale (Claude Code ignores a negative age)",
  "spec": [
    "B2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{\"cachedUsageUtilization\": {\"utilization\": {}, \"fetchedAtMs\": 1791288000001}}"
    }
  },
  "op": {
    "name": "usage",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "fetchedAt": "2026-10-06T12:00:00.001Z",
      "data": {
        "utilization": {},
        "fetchedAtMs": 1791288000001
      },
      "windows": {},
      "stale": true
    }
  }
}
