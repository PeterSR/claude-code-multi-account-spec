{
  "id": "a4-overridden-by-default-settings",
  "description": "default reads ~/.claude/settings.json",
  "spec": [
    "A4 Result"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude/settings.json": {
      "type": "file",
      "content": "{\"apiKeyHelper\": \"x\"}"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "default",
      "pool": null,
      "configDir": "/home/p/.claude",
      "canonical": true,
      "reason": null,
      "source": "default",
      "matchedPath": null,
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_MULTI_ACCOUNT": "default"
        },
        "unset": [
          "CLAUDE_CONFIG_DIR",
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [
        "apiKeyHelper"
      ],
      "ignoredMarkers": [],
      "warnings": [],
      "applied": true,
      "candidates": [
        "default"
      ],
      "globalConfig": "/home/p/.claude.json"
    }
  }
}
