{
  "id": "a2-discover-legacy-config-json",
  "description": "legacy .config.json counts as a global config",
  "spec": [
    "A2 Discovery"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-old/.config.json": {
      "type": "file",
      "content": "{}"
    }
  },
  "op": {
    "name": "discover",
    "args": {}
  },
  "expect": {
    "result": {
      "accounts": [
        {
          "name": "default",
          "configDir": "/home/p/.claude",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "old",
          "configDir": "/home/p/.claude-old",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": true,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        }
      ],
      "conflicts": [],
      "warnings": []
    }
  }
}
