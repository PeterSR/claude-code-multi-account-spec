{
  "id": "b7-adopt-linux",
  "description": "adopt moves ~/.claude and ~/.claude.json into the account and links back",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "dir"
    },
    "/home/p/.claude/.credentials.json": {
      "type": "file",
      "content": "cred"
    },
    "/home/p/.claude.json": {
      "type": "file",
      "content": "{\"a\":1}"
    }
  },
  "op": {
    "name": "adopt",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "state": "managed",
      "name": "work"
    }
  },
  "expectFs": {
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.credentials.json": {
      "type": "file",
      "content": "cred"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{\"a\":1}"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    }
  }
}
