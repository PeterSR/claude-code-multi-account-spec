{
  "id": "a4-reserved-name-in-env-existing",
  "description": "reserved but existing account via env",
  "spec": [
    "A2 Names"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_MULTI_ACCOUNT": "swap-backup"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-swap-backup": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "swap-backup",
      "pool": null,
      "configDir": "/home/p/.claude-swap-backup",
      "canonical": true,
      "reason": null,
      "source": "env",
      "matchedPath": null,
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_CONFIG_DIR": "/home/p/.claude-swap-backup",
          "CLAUDE_MULTI_ACCOUNT": "swap-backup"
        },
        "unset": [
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [],
      "warnings": [
        "RESERVED_NAME",
        "ENV_NOT_APPLIED"
      ],
      "applied": false,
      "candidates": [
        "swap-backup"
      ],
      "globalConfig": "/home/p/.claude-swap-backup/.claude.json"
    }
  }
