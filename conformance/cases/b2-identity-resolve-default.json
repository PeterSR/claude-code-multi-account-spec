{
  "id": "b2-identity-resolve-default",
  "description": "plain default reads ~/.claude.json",
  "spec": [
    "B2",
    "A4 Result"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude.json": {
      "type": "file",
      "content": "{\"oauthAccount\": {\"emailAddress\": \"a@b.c\", \"organizationName\": \"Acme\", \"organizationUuid\": \"org-1\", \"organizationType\": \"claude_max\", \"billingType\": \"stripe_subscription\", \"userRateLimitTier\": \"default_claude_max_5x\", \"organizationRateLimitTier\": \"default_claude_max_5x\", \"accountUuid\": \"acc-1\"}}"
    }
  },
  "op": {
    "name": "identity",
    "args": {
      "resolve": true
    }
  },
  "expect": {
    "result": {
      "email": "a@b.c",
      "orgName": "Acme",
      "orgUuid": "org-1",
      "organizationType": "claude_max",
      "billingType": "stripe_subscription",
      "userRateLimitTier": "default_claude_max_5x",
      "organizationRateLimitTier": "default_claude_max_5x"
    }
  }
}
