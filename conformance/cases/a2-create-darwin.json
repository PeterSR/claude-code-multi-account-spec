{
  "id": "a2-create-darwin",
  "description": "create on darwin",
  "spec": [
    "A2 Create"
  ],
  "platform": "darwin",
  "caseInsensitive": true,
  "home": "/Users/p",
  "cwd": "/Users/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/Users/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "create",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "name": "work",
      "configDir": "/Users/p/.claude-work"
    }
  },
  "expectFs": {
    "/Users/p/.claude-work": {
      "type": "dir",
      "mode": "0700"
    },
    "/Users/p/.claude-work/.multi-account.json": {
      "type": "file",
      "mode": "0600",
      "contentJson": {
        "version": 1,
        "createdAt": "2026-10-06T12:00:00Z"
      }
    }
  }
}
