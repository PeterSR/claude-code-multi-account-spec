{
  "id": "b4-handover-destination-blocked-after-live",
  "description": "SESSION_LIVE comes before DESTINATION_BLOCKED",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/projects/-x/sess-1.jsonl": {
      "type": "file",
      "content": "a"
    },
    "/home/p/.claude-b/projects/-x": {
      "type": "symlink",
      "target": "/data/x"
    },
    "/home/p/.claude-a/sessions/200.json": {
      "type": "file",
      "content": "{\"pid\": 200, \"sessionId\": \"sess-1\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    }
  },
  "processes": {
    "200": {
      "procStart": "T1",
      "pidDomain": "host-1"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "a",
      "to": "b"
    }
  },
  "expect": {
    "error": {
      "code": "SESSION_LIVE",
      "path": null
    }
  }
}
