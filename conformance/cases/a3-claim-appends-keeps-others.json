{
  "id": "a3-claim-appends-keeps-others",
  "description": "existing claims and unknown keys stay",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"directories\": [\"/srv/a\"], \"label\": \"L\"}"
    },
    "/srv/a": {
      "type": "dir"
    },
    "/srv/b": {
      "type": "dir"
    }
  },
  "op": {
    "name": "claim",
    "args": {
      "name": "work",
      "dir": "/srv/b"
    }
  },
  "expect": {
    "result": {
      "directories": [
        "/srv/a",
        "/srv/b"
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1,
        "directories": [
          "/srv/a",
          "/srv/b"
        ],
        "label": "L"
      }
    }
  }
}
