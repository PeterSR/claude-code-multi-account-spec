{
  "id": "b4-handover-source-linked-project-only-not-found",
  "description": "only a linked project folder holds the id: SESSION_NOT_FOUND",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/projects/-x": {
      "type": "symlink",
      "target": "/data/x"
    },
    "/data/x/sess-1.jsonl": {
      "type": "file",
      "content": "secret"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "a",
      "to": "b"
    }
  },
  "expect": {
    "error": {
      "code": "SESSION_NOT_FOUND",
      "path": null
    }
  },
  "expectFs": {
    "/home/p/.claude-b/projects": null
  }
}
