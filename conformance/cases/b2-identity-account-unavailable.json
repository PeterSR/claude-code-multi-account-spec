{
  "id": "b2-identity-account-unavailable",
  "description": "dangling account",
  "spec": [
    "B2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "symlink",
      "target": "/mnt/gone"
    }
  },
  "op": {
    "name": "identity",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "error": {
      "code": "ACCOUNT_UNAVAILABLE",
      "path": "/home/p/.claude-work"
    }
  }
}
