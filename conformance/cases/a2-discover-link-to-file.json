{
  "id": "a2-discover-link-to-file",
  "description": "link to a non-directory gives NOT_A_DIRECTORY",
  "spec": [
    "A2 Discovery"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-odd": {
      "type": "symlink",
      "target": "/data/file.txt"
    },
    "/data/file.txt": {
      "type": "file",
      "content": "x"
    },
    "/home/p/.claude-real": {
      "type": "dir"
    }
  },
  "op": {
    "name": "discover",
    "args": {}
  },
  "expect": {
    "result": {
      "accounts": [
        {
          "name": "default",
          "configDir": "/home/p/.claude",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "real",
          "configDir": "/home/p/.claude-real",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        }
      ],
      "conflicts": [],
      "warnings": [
        "NOT_A_DIRECTORY"
      ]
    }
  }
}
