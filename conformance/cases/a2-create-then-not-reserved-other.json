{
  "id": "a2-create-then-not-reserved-other",
  "description": "a legal sibling name is created next to existing accounts",
  "spec": [
    "A2 Create"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "create",
    "args": {
      "name": "personal"
    }
  },
  "expect": {
    "result": {
      "name": "personal",
      "configDir": "/home/p/.claude-personal"
    }
  },
  "expectFs": {
    "/home/p/.claude-personal/.multi-account.json": {
      "type": "file",
      "contentJson": {
        "version": 1,
        "createdAt": "2026-10-06T12:00:00Z"
      }
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  }
}
