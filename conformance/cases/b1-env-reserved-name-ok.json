{
  "id": "b1-env-reserved-name-ok",
  "description": "env is a pure function and ignores reservation",
  "spec": [
    "B1"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "env",
    "args": {
      "name": "profiles"
    }
  },
  "expect": {
    "result": {
      "set": {
        "CLAUDE_CONFIG_DIR": "/home/p/.claude-profiles",
        "CLAUDE_MULTI_ACCOUNT": "profiles"
      },
      "unset": [
        "CLAUDE_MULTI_ACCOUNT_SOURCE",
        "CLAUDE_SECURESTORAGE_CONFIG_DIR"
      ],
      "overriddenBy": []
    }
  }
}
