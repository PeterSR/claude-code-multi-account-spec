{
  "id": "a4-overridden-by-env-vars",
  "description": "all four override variables, in fixed order",
  "spec": [
    "A4 Result"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_MULTI_ACCOUNT": "work",
    "CLAUDE_CODE_CUSTOM_OAUTH_URL": "https://x.test",
    "CLAUDE_SECURESTORAGE_CONFIG_DIR": "/s",
    "ANTHROPIC_API_KEY": "k",
    "CLAUDE_CODE_OAUTH_TOKEN": "t"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "work",
      "pool": null,
      "configDir": "/home/p/.claude-work",
      "canonical": true,
      "reason": null,
      "source": "env",
      "matchedPath": null,
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_CONFIG_DIR": "/home/p/.claude-work",
          "CLAUDE_MULTI_ACCOUNT": "work"
        },
        "unset": [
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [
        "CLAUDE_CODE_OAUTH_TOKEN",
        "ANTHROPIC_API_KEY",
        "CLAUDE_SECURESTORAGE_CONFIG_DIR",
        "CLAUDE_CODE_CUSTOM_OAUTH_URL"
      ],
      "ignoredMarkers": [],
      "warnings": [
        "ENV_NOT_APPLIED"
      ],
      "applied": false,
      "candidates": [
        "work"
      ],
      "globalConfig": "/home/p/.claude-work/.claude-custom-oauth.json"
    }
  }
}
