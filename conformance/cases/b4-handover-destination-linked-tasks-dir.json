{
  "id": "b4-handover-destination-linked-tasks-dir",
  "description": "a linked destination tasks directory blocks the handover",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/file-history/sess-1/v1": {
      "type": "file",
      "content": "h"
    },
    "/home/p/.claude-a/tasks/sess-1/t.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-b/tasks": {
      "type": "symlink",
      "target": "/data/t"
    },
    "/data/t": {
      "type": "dir"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "a",
      "to": "b"
    }
  },
  "expect": {
    "error": {
      "code": "DESTINATION_BLOCKED",
      "path": "/home/p/.claude-b/tasks"
    }
  },
  "expectFs": {
    "/data/t/sess-1": null,
    "/home/p/.claude-b/file-history": null
  }
}
