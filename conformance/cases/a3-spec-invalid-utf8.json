{
  "id": "a3-spec-invalid-utf8",
  "description": "a spec file with invalid UTF-8 is invalid",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "contentBase64": "eyJ2ZXJzaW9uIjogMSwgImxhYmVsIjogImNhZukifQ=="
    }
  },
  "op": {
    "name": "discover",
    "args": {}
  },
  "expect": {
    "result": {
      "accounts": [
        {
          "name": "default",
          "configDir": "/home/p/.claude",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "work",
          "configDir": "/home/p/.claude-work",
          "state": "ok",
          "hasSpecFile": true,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": {
            "code": "SPEC_FILE_INVALID",
            "path": "/home/p/.claude-work/.multi-account.json"
          },
          "warnings": []
        }
      ],
      "conflicts": [],
      "warnings": []
    }
  }
}
