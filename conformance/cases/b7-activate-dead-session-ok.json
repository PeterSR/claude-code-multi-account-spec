{
  "id": "b7-activate-dead-session-ok",
  "description": "a dead session does not block",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-personal/.claude.json": {
      "type": "file",
      "content": "{\"p\":1}"
    },
    "/home/p/.claude-personal/.credentials.json": {
      "type": "file",
      "content": "pc"
    },
    "/home/p/.claude-work/.credentials.json": {
      "type": "file",
      "content": "wc"
    },
    "/home/p/.claude-work/sessions/300.json": {
      "type": "file",
      "content": "{\"pid\": 300, \"sessionId\": \"live-one\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    }
  },
  "processes": {
    "300": {
      "procStart": "OTHER",
      "pidDomain": "host-1"
    }
  },
  "op": {
    "name": "activate",
    "args": {
      "name": "personal"
    }
  },
  "expect": {
    "result": {
      "state": "managed",
      "name": "personal"
    }
  },
  "expectFs": {
    "/home/p/.claude": {
      "target": "/home/p/.claude-personal"
    },
    "/home/p/.claude.json": {
      "target": "/home/p/.claude-personal/.claude.json"
    }
  }
}
