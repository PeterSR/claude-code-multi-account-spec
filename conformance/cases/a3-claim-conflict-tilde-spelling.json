{
  "id": "a3-claim-conflict-tilde-spelling",
  "description": "a ~/ claim by another account clashes with the absolute spelling",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1}"
    },
    "/home/p/.claude-personal/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"directories\": [\"~/dev\"]}"
    },
    "/home/p/dev": {
      "type": "dir"
    }
  },
  "op": {
    "name": "claim",
    "args": {
      "name": "work",
      "dir": "/home/p/dev"
    }
  },
  "expect": {
    "error": {
      "code": "CLAIM_CONFLICT",
      "path": "/home/p/dev"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1
      }
    }
  }
}
