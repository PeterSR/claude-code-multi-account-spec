{
  "id": "b6-pick-alias-named-represents",
  "description": "default is the slot alias of work: the named account is the member, default is not",
  "spec": [
    "B6"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"pool\": \"p\"}"
    }
  },
  "op": {
    "name": "pick",
    "args": {
      "pool": "p"
    }
  },
  "expect": {
    "result": {
      "account": "work"
    }
  }
}
