{
  "id": "b7-slot-broken-link-outside-home-naming",
  "description": "~/.claude links to a dir that is not ~/.claude-<name>",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/data/x"
    },
    "/data/x": {
      "type": "dir"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/data/x/.claude.json"
    },
    "/data/x/.claude.json": {
      "type": "file",
      "content": "{}"
    }
  },
  "op": {
    "name": "slot",
    "args": {}
  },
  "expect": {
    "result": {
      "state": "broken",
      "name": null
    }
  }
}
