{
  "id": "a4-marker-list-after-comment",
  "description": "comments and blank lines are skipped first",
  "spec": [
    "A4 Marker parsing"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/proj/.claude-account": {
      "type": "file",
      "content": "# order\n\nwork, personal\n"
    }
  },
  "op": {
    "name": "parse_marker",
    "args": {
      "path": "/home/p/proj/.claude-account"
    }
  },
  "expect": {
    "result": {
      "kind": "list",
      "name": "work",
      "pool": null,
      "candidates": [
        "work",
        "personal"
      ]
    }
  }
}
