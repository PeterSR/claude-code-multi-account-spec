{
  "id": "a2-discover-link-loop",
  "description": "a link cycle is ELOOP, reported as dangling",
  "spec": [
    "A2 Discovery"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-loop": {
      "type": "symlink",
      "target": "/home/p/.claude-loop2"
    },
    "/home/p/.claude-loop2": {
      "type": "symlink",
      "target": "/home/p/.claude-loop"
    }
  },
  "op": {
    "name": "discover",
    "args": {}
  },
  "expect": {
    "result": {
      "accounts": [
        {
          "name": "default",
          "configDir": "/home/p/.claude",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "loop",
          "configDir": "/home/p/.claude-loop",
          "state": "dangling",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "loop2",
          "configDir": "/home/p/.claude-loop2",
          "state": "dangling",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        }
      ],
      "conflicts": [],
      "warnings": []
    }
  }
}
