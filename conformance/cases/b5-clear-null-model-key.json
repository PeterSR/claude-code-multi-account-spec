{
  "id": "b5-clear-null-model-key",
  "description": "model null clears the all-models entry only",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": [{\"window\": \"five_hour\", \"model\": null, \"until\": \"2026-10-06T18:00:00Z\", \"reason\": \"rate_limit\", \"updatedBy\": \"x\", \"updatedAt\": \"2026-10-01T00:00:00Z\"}, {\"window\": \"five_hour\", \"model\": \"opus\", \"until\": \"2026-10-06T18:00:00Z\", \"reason\": \"rate_limit\", \"updatedBy\": \"x\", \"updatedAt\": \"2026-10-01T00:00:00Z\"}]}",
      "mode": "0600"
    }
  },
  "op": {
    "name": "clear_limited",
    "args": {
      "name": "work",
      "window": "five_hour",
      "model": null
    }
  },
  "expect": {
    "result": {
      "limits": [
        {
          "window": "five_hour",
          "model": "opus",
          "until": "2026-10-06T18:00:00Z",
          "reason": "rate_limit",
          "updatedBy": "x",
          "updatedAt": "2026-10-01T00:00:00Z"
        }
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "mode": "0600",
      "contentJson": {
        "version": 1,
        "limits": [
          {
            "window": "five_hour",
            "model": "opus",
            "until": "2026-10-06T18:00:00Z",
            "reason": "rate_limit",
            "updatedBy": "x",
            "updatedAt": "2026-10-01T00:00:00Z"
          }
        ]
      }
    }
  }
}
