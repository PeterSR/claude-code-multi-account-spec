{
  "id": "a4-spec-invalid-after-ignored-repo-marker",
  "description": "an ignored repo marker does not bind, so claims are needed",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p/dev/repo",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-bad/.multi-account.json": {
      "type": "file",
      "content": "{nope"
    },
    "/home/p/dev/repo/.git": {
      "type": "dir"
    },
    "/home/p/dev/repo/.claude-account": {
      "type": "file",
      "content": "work"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "error": {
      "code": "SPEC_FILE_INVALID",
      "path": "/home/p/.claude-bad/.multi-account.json"
    }
  }
}
