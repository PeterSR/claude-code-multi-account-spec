{
  "id": "a3-update-spec-file-refuses-invalid-existing",
  "description": "an existing invalid file is never overwritten",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{nope"
    }
  },
  "op": {
    "name": "update_spec_file",
    "args": {
      "name": "work",
      "patch": {
        "label": "L"
      }
    }
  },
  "expect": {
    "error": {
      "code": "SPEC_FILE_INVALID",
      "path": "/home/p/.claude-work/.multi-account.json"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "content": "{nope"
    },
    "/home/p/.claude-work/.multi-account.json.lock": null
  }
}
