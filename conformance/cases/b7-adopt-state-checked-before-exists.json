{
  "id": "b7-adopt-state-checked-before-exists",
  "description": "SLOT_STATE precedes ACCOUNT_EXISTS",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    }
  },
  "op": {
    "name": "adopt",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "error": {
      "code": "SLOT_STATE",
      "path": null
    }
  }
}
