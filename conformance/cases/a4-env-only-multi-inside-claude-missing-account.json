{
  "id": "a4-env-only-multi-inside-claude-missing-account",
  "description": "a missing account is reported before the conflict",
  "spec": [
    "A4 Step 1.3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_MULTI_ACCOUNT": "work",
    "CLAUDECODE": "1"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "error": {
      "code": "ACCOUNT_NOT_FOUND",
      "path": "/home/p/.claude-work"
    }
  }
}
