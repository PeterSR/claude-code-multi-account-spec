{
  "id": "b4-handover-top-level-link-skipped-with-others",
  "description": "a linked location is skipped and reported while real ones are copied",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/projects/-s1/sess-1.jsonl": {
      "type": "file",
      "content": "t"
    },
    "/home/p/.claude-a/tasks/sess-1": {
      "type": "symlink",
      "target": "/data/t"
    },
    "/data/t/t.json": {
      "type": "file",
      "content": "{}"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "a",
      "to": "b"
    }
  },
  "expect": {
    "result": {
      "copied": [
        "projects/-s1/sess-1.jsonl"
      ],
      "skipped": [
        "tasks/sess-1"
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-b/tasks": null
  }
}
