{
  "id": "a3-update-spec-file-lock-busy",
  "description": "a fresh lock",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1}"
    },
    "/home/p/.claude-work/.multi-account.json.lock": {
      "type": "dir"
    }
  },
  "op": {
    "name": "update_spec_file",
    "args": {
      "name": "work",
      "patch": {
        "label": "L"
      }
    }
  },
  "expect": {
    "error": {
      "code": "LOCK_BUSY",
      "path": "/home/p/.claude-work/.multi-account.json.lock"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json.lock": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1
      }
    }
  }
}
