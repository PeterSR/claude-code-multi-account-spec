{
  "id": "a2-discover-alias-three",
  "description": "three names for one directory all point at the first",
  "spec": [
    "A2 Relocation"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "symlink",
      "target": "/home/p/.claude-a"
    },
    "/home/p/.claude-c": {
      "type": "symlink",
      "target": "/home/p/.claude-b"
    }
  },
  "op": {
    "name": "discover",
    "args": {}
  },
  "expect": {
    "result": {
      "accounts": [
        {
          "name": "default",
          "configDir": "/home/p/.claude",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "a",
          "configDir": "/home/p/.claude-a",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "b",
          "configDir": "/home/p/.claude-b",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": "a",
          "specError": null,
          "warnings": []
        },
        {
          "name": "c",
          "configDir": "/home/p/.claude-c",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": "a",
          "specError": null,
          "warnings": []
        }
      ],
      "conflicts": [],
      "warnings": []
    }
  }
}
