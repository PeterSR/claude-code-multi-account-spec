{
  "id": "a2-canonical-default",
  "description": "canonical path of default is $HOME/.claude",
  "spec": [
    "A2 Storage",
    "A4 Result"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "canonical_path",
    "args": {
      "name": "default"
    }
  },
  "expect": {
    "result": {
      "path": "/home/p/.claude"
    }
  }
}
