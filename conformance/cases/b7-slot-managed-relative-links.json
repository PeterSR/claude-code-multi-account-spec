{
  "id": "b7-slot-managed-relative-links",
  "description": "relative link targets resolve against the home dir",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": ".claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": ".claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    }
  },
  "op": {
    "name": "slot",
    "args": {}
  },
  "expect": {
    "result": {
      "state": "managed",
      "name": "work"
    }
  }
}
