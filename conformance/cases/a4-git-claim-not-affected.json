{
  "id": "a4-git-claim-not-affected",
  "description": "claims bind inside a git tree; the ignored marker is still listed",
  "spec": [
    "A4 Markers in git working trees"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p/dev/repo",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/dev/repo/.git": {
      "type": "dir"
    },
    "/home/p/dev/repo/.claude-account": {
      "type": "file",
      "content": "personal\n"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"directories\": [\"~/dev/repo\"]}"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-personal": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "work",
      "pool": null,
      "configDir": "/home/p/.claude-work",
      "canonical": true,
      "reason": null,
      "source": "claim",
      "matchedPath": "/home/p/dev/repo",
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_CONFIG_DIR": "/home/p/.claude-work",
          "CLAUDE_MULTI_ACCOUNT": "work"
        },
        "unset": [
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [
        "/home/p/dev/repo/.claude-account"
      ],
      "warnings": [
        "MARKER_IGNORED_IN_REPO"
      ],
      "applied": true,
      "candidates": [
        "work"
      ],
      "globalConfig": "/home/p/.claude-work/.claude.json"
    }
  }
}
