{
  "id": "b5-available-ignores-malformed-entries",
  "description": "junk and entries without a usable until are ignored",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": [\"x\", {\"window\": \"a\"}, {\"until\": \"soon\", \"model\": null}, {\"window\": \"five_hour\", \"model\": null, \"until\": \"2026-10-06T18:00:00Z\", \"reason\": \"rate_limit\", \"updatedBy\": \"x\", \"updatedAt\": \"2026-10-06T12:00:00Z\"}]}"
    }
  },
  "op": {
    "name": "available",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "available": false
    }
  }
}
