{
  "id": "b1-env-reports-auth-overrides",
  "description": "auth overrides are reported, not touched",
  "spec": [
    "B1"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_CODE_OAUTH_TOKEN": "t",
    "ANTHROPIC_API_KEY": "k"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "env",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "set": {
        "CLAUDE_CONFIG_DIR": "/home/p/.claude-work",
        "CLAUDE_MULTI_ACCOUNT": "work"
      },
      "unset": [
        "CLAUDE_MULTI_ACCOUNT_SOURCE",
        "CLAUDE_SECURESTORAGE_CONFIG_DIR"
      ],
      "overriddenBy": [
        "CLAUDE_CODE_OAUTH_TOKEN",
        "ANTHROPIC_API_KEY"
      ]
    }
  }
}
