{
  "id": "a2-create-exists-dir",
  "description": "create on an existing dir",
  "spec": [
    "A2 Create"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "create",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "error": {
      "code": "ACCOUNT_EXISTS",
      "path": "/home/p/.claude-work"
    }
  }
}
