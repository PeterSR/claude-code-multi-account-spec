{
  "id": "b4-handover-partial",
  "description": "only the locations that exist are copied",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/projects/-home-p-x/sess-1.jsonl": {
      "type": "file",
      "content": "t"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "a",
      "to": "b"
    }
  },
  "expect": {
    "result": {
      "copied": [
        "projects/-home-p-x/sess-1.jsonl"
      ],
      "skipped": []
    }
  },
  "expectFs": {
    "/home/p/.claude-b/projects/-home-p-x/sess-1.jsonl": {
      "type": "file",
      "content": "t"
    },
    "/home/p/.claude-b/tasks": null,
    "/home/p/.claude-b/file-history": null
  }
}
