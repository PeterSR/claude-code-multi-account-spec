{
  "id": "a3-unclaim-removes",
  "description": "the claim is removed, other keys stay",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"directories\": [\"~/dev/personal\", \"/srv/a\"], \"label\": \"L\"}"
    },
    "/home/p/dev/personal": {
      "type": "dir"
    },
    "/srv/a": {
      "type": "dir"
    }
  },
  "op": {
    "name": "unclaim",
    "args": {
      "name": "work",
      "dir": "/home/p/dev/personal"
    }
  },
  "expect": {
    "result": {
      "directories": [
        "/srv/a"
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1,
        "directories": [
          "/srv/a"
        ],
        "label": "L"
      },
      "mode": "0600"
    },
    "/home/p/.claude-work/.multi-account.json.lock": null
  }
}
