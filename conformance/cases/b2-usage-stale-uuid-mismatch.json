{
  "id": "b2-usage-stale-uuid-mismatch",
  "description": "a cache for another account is stale",
  "spec": [
    "B2"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{\"cachedUsageUtilization\": {\"utilization\": {}, \"fetchedAtMs\": 1791287400000, \"accountUuid\": \"acc-2\"}, \"oauthAccount\": {\"emailAddress\": \"a@b.c\", \"organizationName\": \"Acme\", \"organizationUuid\": \"org-1\", \"organizationType\": \"claude_max\", \"billingType\": \"stripe_subscription\", \"userRateLimitTier\": \"default_claude_max_5x\", \"organizationRateLimitTier\": \"default_claude_max_5x\", \"accountUuid\": \"acc-1\"}}"
    }
  },
  "op": {
    "name": "usage",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "fetchedAt": "2026-10-06T11:50:00.000Z",
      "data": {
        "utilization": {},
        "fetchedAtMs": 1791287400000,
        "accountUuid": "acc-2"
      },
      "windows": {},
      "stale": true
    }
  }
}
