{
  "id": "a2-canonical-reserved-is-pure",
  "description": "canonical_path does not apply reservation",
  "spec": [
    "A2 Names"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "canonical_path",
    "args": {
      "name": "profiles"
    }
  },
  "expect": {
    "result": {
      "path": "/home/p/.claude-profiles"
    }
  }
}
