{
  "id": "b5-mark-symlink-lock-named-after-link",
  "description": "the lock is named after the path as given, not the link target",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "symlink",
      "target": "/data/state.json"
    },
    "/data/state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": []}",
      "mode": "0600"
    },
    "/home/p/.claude-work/.multi-account-state.json.lock": {
      "type": "dir"
    }
  },
  "op": {
    "name": "mark_limited",
    "args": {
      "name": "work",
      "entry": {
        "window": "seven_day",
        "model": "opus",
        "until": "2026-10-09T14:00:00Z",
        "reason": "rate_limit",
        "updatedBy": "my-swapper"
      }
    }
  },
  "expect": {
    "error": {
      "code": "LOCK_BUSY",
      "path": "/home/p/.claude-work/.multi-account-state.json.lock"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account-state.json.lock": {
      "type": "dir"
    }
  }
}
