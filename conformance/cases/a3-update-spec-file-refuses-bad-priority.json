{
  "id": "a3-update-spec-file-refuses-bad-priority",
  "description": "a patch the library would reject is refused and nothing is written",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1}"
    }
  },
  "op": {
    "name": "update_spec_file",
    "args": {
      "name": "work",
      "patch": {
        "priority": 1.5
      }
    }
  },
  "expect": {
    "error": {
      "code": "INVALID_ENTRY",
      "path": null
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1
      }
    },
    "/home/p/.claude-work/.multi-account.json.lock": null
  }
}
