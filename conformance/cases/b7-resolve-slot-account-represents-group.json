{
  "id": "b7-resolve-slot-account-represents-group",
  "description": "the named account represents the group and has no aliasOf; it counts as applied because default is the same directory",
  "spec": [
    "B7",
    "A2 Relocation"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_MULTI_ACCOUNT": "work"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "work",
      "pool": null,
      "configDir": "/home/p/.claude-work",
      "canonical": true,
      "reason": null,
      "source": "env",
      "matchedPath": null,
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_CONFIG_DIR": "/home/p/.claude-work",
          "CLAUDE_MULTI_ACCOUNT": "work"
        },
        "unset": [
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [],
      "warnings": [],
      "applied": true,
      "candidates": [
        "work"
      ],
      "globalConfig": "/home/p/.claude-work/.claude.json"
    }
  }
}
