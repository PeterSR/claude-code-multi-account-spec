{
  "id": "a3-update-spec-file-null-removes",
  "description": "a null value removes the key",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"label\": \"x\"}"
    }
  },
  "op": {
    "name": "update_spec_file",
    "args": {
      "name": "work",
      "patch": {
        "label": null
      }
    }
  },
  "expect": {
    "result": {
      "version": 1
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1
      }
    }
  }
}
