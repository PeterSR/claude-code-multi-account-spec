{
  "id": "b5-clear-keeps-foreign-entries",
  "description": "clear removes only the named key and keeps other entries verbatim",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": [{\"window\": \"weekly\", \"model\": null, \"until\": \"2026-10-09T14:00:00Z\", \"note\": \"from another tool\"}, {\"window\": \"seven_day\", \"model\": \"opus\", \"until\": \"2026-10-09T14:00:00Z\", \"reason\": \"rate_limit\", \"updatedBy\": \"my-swapper\", \"updatedAt\": \"2026-10-01T00:00:00Z\"}]}"
    }
  },
  "op": {
    "name": "clear_limited",
    "args": {
      "name": "work",
      "window": "seven_day",
      "model": "opus"
    }
  },
  "expect": {
    "result": {
      "limits": [
        {
          "window": "weekly",
          "model": null,
          "until": "2026-10-09T14:00:00Z",
          "note": "from another tool"
        }
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "file",
      "mode": "0600",
      "contentJson": {
        "version": 1,
        "limits": [
          {
            "window": "weekly",
            "model": null,
            "until": "2026-10-09T14:00:00Z",
            "note": "from another tool"
          }
        ]
      }
    }
  }
}
