{
  "id": "a3-update-spec-file-through-link",
  "description": "a linked spec file is written through, the link stays",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "symlink",
      "target": "/data/s.json"
    },
    "/data/s.json": {
      "type": "file",
      "content": "{\"version\": 1}"
    }
  },
  "op": {
    "name": "update_spec_file",
    "args": {
      "name": "work",
      "patch": {
        "label": "L"
      }
    }
  },
  "expect": {
    "result": {
      "version": 1,
      "label": "L"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "type": "symlink",
      "target": "/data/s.json"
    },
    "/data/s.json": {
      "contentJson": {
        "version": 1,
        "label": "L"
      }
    },
    "/home/p/.claude-work/.multi-account.json.lock": null
  }
}
