{
  "id": "b5-mark-symlink-target-lock-does-not-block",
  "description": "a lock next to the link target is not our lock",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "symlink",
      "target": "/data/state.json"
    },
    "/data/state.json": {
      "type": "file",
      "content": "{\"version\": 1, \"limits\": []}",
      "mode": "0600"
    },
    "/data/state.json.lock": {
      "type": "dir"
    }
  },
  "op": {
    "name": "mark_limited",
    "args": {
      "name": "work",
      "entry": {
        "window": "seven_day",
        "model": "opus",
        "until": "2026-10-09T14:00:00Z",
        "reason": "rate_limit",
        "updatedBy": "my-swapper"
      }
    }
  },
  "expect": {
    "result": {
      "limits": [
        {
          "window": "seven_day",
          "model": "opus",
          "until": "2026-10-09T14:00:00Z",
          "reason": "rate_limit",
          "updatedBy": "my-swapper",
          "updatedAt": "2026-10-06T12:00:00Z"
        }
      ]
    }
  },
  "expectFs": {
    "/data/state.json.lock": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json.lock": null
  }
}
