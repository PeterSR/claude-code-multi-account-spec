      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_MULTI_ACCOUNT": "default"
        },
        "unset": [
          "CLAUDE_CONFIG_DIR",
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [],
      "warnings": [],
