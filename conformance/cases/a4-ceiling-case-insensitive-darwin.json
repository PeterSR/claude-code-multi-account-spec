{
  "id": "a4-ceiling-case-insensitive-darwin",
  "description": "on a case-insensitive fs the ceiling matches ignoring case",
  "spec": [
    "A4 Step 2"
  ],
  "platform": "darwin",
  "caseInsensitive": true,
  "home": "/Users/p",
  "cwd": "/Users/p/proj/sub",
  "env": {},
  "options": {
    "ceilingDirs": [
      "/users/P/PROJ"
    ]
  },
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/Users/p": {
      "type": "dir"
    },
    "/Users/p/.claude-account": {
