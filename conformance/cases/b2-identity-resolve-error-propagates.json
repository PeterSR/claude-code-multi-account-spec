{
  "id": "b2-identity-resolve-error-propagates",
  "description": "a resolve error is returned as is",
  "spec": [
    "B2",
    "A4 Result"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {
    "CLAUDE_CONFIG_DIR": "/home/p/.claude-work",
    "CLAUDE_MULTI_ACCOUNT": "personal"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-personal": {
      "type": "dir"
    }
  },
  "op": {
    "name": "identity",
    "args": {
      "resolve": true
    }
  },
  "expect": {
    "error": {
      "code": "ENV_CONFLICT",
      "path": null
    }
  }
}
