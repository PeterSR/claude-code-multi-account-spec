{
  "id": "b6-pick-priority-2pow53-invalid",
  "description": "priority 2^53 makes the spec file invalid",
  "spec": [
    "B6",
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"pool\": \"p\", \"priority\": 0}"
    },
    "/home/p/.claude-b/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"pool\": \"p\", \"priority\": 9007199254740992}"
    }
  },
  "op": {
    "name": "pick",
    "args": {
      "pool": "p"
    }
  },
  "expect": {
    "error": {
      "code": "SPEC_FILE_INVALID",
      "path": "/home/p/.claude-b/.multi-account.json"
    }
  }
}
