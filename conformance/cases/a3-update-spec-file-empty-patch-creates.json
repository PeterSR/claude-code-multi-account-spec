{
  "id": "a3-update-spec-file-empty-patch-creates",
  "description": "an empty patch on a missing file still creates it",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "update_spec_file",
    "args": {
      "name": "work",
      "patch": {}
    }
  },
  "expect": {
    "result": {
      "version": 1
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1
      }
    }
  }
}
