{
  "id": "b6-pick-from-dangling-account",
  "description": "a dangling candidate is skipped as unavailable",
  "spec": [
    "B6"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-c": {
      "type": "dir"
    },
    "/home/p/.claude-gone": {
      "type": "symlink",
      "target": "/mnt/gone"
    }
  },
  "op": {
    "name": "pick_from",
    "args": {
      "candidates": [
        "gone",
        "a"
      ]
    }
  },
  "expect": {
    "result": {
      "account": "a"
    }
  }
}
