{
  "id": "b4-handover-overwrite-failure-keeps-destination",
  "description": "with overwrite a failed copy leaves the old destination intact",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/projects/-s1/sess-1.jsonl": {
      "type": "file",
      "content": "new"
    },
    "/home/p/.claude-a/tasks/sess-1/t.json": {
      "type": "file",
      "content": "{}",
      "unreadable": true
    },
    "/home/p/.claude-b/tasks/sess-1/old.json": {
      "type": "file",
      "content": "old"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "a",
      "to": "b",
      "overwrite": true
    }
  },
  "expect": {
    "error": {
      "code": "IO_ERROR",
      "path": "/home/p/.claude-a/tasks/sess-1/t.json"
    }
  },
  "expectFs": {
    "/home/p/.claude-b/tasks/sess-1/old.json": {
      "type": "file",
      "content": "old"
    },
    "/home/p/.claude-b/projects": null
  }
}
