{
  "id": "a4-claim-tilde-home",
  "description": "a bare ~/ claims the home directory",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p/x",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"directories\": [\"~/\"]}"
    },
    "/home/p/x": {
      "type": "dir"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "work",
      "pool": null,
      "configDir": "/home/p/.claude-work",
      "canonical": true,
      "reason": null,
      "source": "claim",
      "matchedPath": "/home/p",
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_CONFIG_DIR": "/home/p/.claude-work",
          "CLAUDE_MULTI_ACCOUNT": "work"
        },
        "unset": [
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [],
      "warnings": [],
      "applied": true,
      "candidates": [
        "work"
      ],
      "globalConfig": "/home/p/.claude-work/.claude.json"
    }
  }
}
