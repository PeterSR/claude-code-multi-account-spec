{
  "id": "b4-handover-top-level-link-only-not-found",
  "description": "a link where a session location should be does not count as the session",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/file-history/sess-1": {
      "type": "symlink",
      "target": "/data/h"
    },
    "/data/h/v1": {
      "type": "file",
      "content": "h"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "a",
      "to": "b"
    }
  },
  "expect": {
    "error": {
      "code": "SESSION_NOT_FOUND",
      "path": null
    }
  },
  "expectFs": {
    "/home/p/.claude-b/file-history": null
  }
}
