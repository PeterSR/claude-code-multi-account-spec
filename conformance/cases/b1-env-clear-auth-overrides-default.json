{
  "id": "b1-env-clear-auth-overrides-default",
  "description": "clearAuthOverrides for default",
  "spec": [
    "B1"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "env",
    "args": {
      "name": "default",
      "clearAuthOverrides": true
    }
  },
  "expect": {
    "result": {
      "set": {
        "CLAUDE_MULTI_ACCOUNT": "default"
      },
      "unset": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_PROFILE",
        "CLAUDE_CODE_OAUTH_TOKEN",
        "CLAUDE_CODE_USE_BEDROCK",
        "CLAUDE_CODE_USE_FOUNDRY",
        "CLAUDE_CODE_USE_VERTEX",
        "CLAUDE_CONFIG_DIR",
        "CLAUDE_MULTI_ACCOUNT_SOURCE",
        "CLAUDE_SECURESTORAGE_CONFIG_DIR"
      ],
      "overriddenBy": []
    }
  }
}
