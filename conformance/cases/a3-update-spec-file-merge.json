{
  "id": "a3-update-spec-file-merge",
  "description": "top-level keys are merged, unknown keys kept, mode 0600",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1, \"label\": \"Old\", \"extra\": [1]}"
    }
  },
  "op": {
    "name": "update_spec_file",
    "args": {
      "name": "work",
      "patch": {
        "label": "New",
        "pool": "p"
      }
    }
  },
  "expect": {
    "result": {
      "version": 1,
      "label": "New",
      "pool": "p",
      "extra": [
        1
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "mode": "0600",
      "contentJson": {
        "version": 1,
        "label": "New",
        "pool": "p",
        "extra": [
          1
        ]
      }
    },
    "/home/p/.claude-work/.multi-account.json.lock": null
  }
}
