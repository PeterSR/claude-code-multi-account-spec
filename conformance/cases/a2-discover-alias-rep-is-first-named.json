{
  "id": "a2-discover-alias-rep-is-first-named",
  "description": "in a group of default and two named links the first named account in name order represents it",
  "spec": [
    "A2 Relocation"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-zed"
    },
    "/home/p/.claude-zed": {
      "type": "dir"
    },
    "/home/p/.claude-abc": {
      "type": "symlink",
      "target": "/home/p/.claude-zed"
    }
  },
  "op": {
    "name": "discover",
    "args": {}
  },
  "expect": {
    "result": {
      "accounts": [
        {
          "name": "default",
          "configDir": "/home/p/.claude",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": "abc",
          "specError": null,
          "warnings": []
        },
        {
          "name": "abc",
          "configDir": "/home/p/.claude-abc",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "zed",
          "configDir": "/home/p/.claude-zed",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": "abc",
          "specError": null,
          "warnings": []
        }
      ],
      "conflicts": [],
      "warnings": []
    }
  }
}
