{
  "id": "b7-activate-stale-slot-lock",
  "description": "a stale slot lock is taken over",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-personal/.claude.json": {
      "type": "file",
      "content": "{\"p\":1}"
    },
    "/home/p/.claude-personal/.credentials.json": {
      "type": "file",
      "content": "pc"
    },
    "/home/p/.claude-work/.credentials.json": {
      "type": "file",
      "content": "wc"
    },
    "/home/p/.claude-slot.lock": {
      "type": "dir",
      "mtime": "2026-10-06T11:00:00Z"
    }
  },
  "op": {
    "name": "activate",
    "args": {
      "name": "personal"
    }
  },
  "expect": {
    "result": {
      "state": "managed",
      "name": "personal"
    }
  },
  "expectFs": {
    "/home/p/.claude-slot.lock": null
  }
}
