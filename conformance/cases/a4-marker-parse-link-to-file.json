{
  "id": "a4-marker-parse-link-to-file",
  "description": "a link is followed",
  "spec": [
    "A4 Marker parsing"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/proj/.claude-account": {
      "type": "symlink",
      "target": "/data/m"
    },
    "/data/m": {
      "type": "file",
      "content": "work\n"
    }
  },
  "op": {
    "name": "parse_marker",
    "args": {
      "path": "/home/p/proj/.claude-account"
    }
  },
  "expect": {
    "result": {
      "kind": "account",
      "name": "work",
      "pool": null,
      "candidates": [
        "work"
      ]
    }
  }
}
