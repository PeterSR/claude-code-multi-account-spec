{
  "id": "a3-claim-outside-home-stored-absolute",
  "description": "a directory outside home stays absolute",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1}"
    },
    "/srv/code": {
      "type": "dir"
    }
  },
  "op": {
    "name": "claim",
    "args": {
      "name": "work",
      "dir": "/srv/code"
    }
  },
  "expect": {
    "result": {
      "directories": [
        "/srv/code"
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1,
        "directories": [
          "/srv/code"
        ]
      }
    }
  }
}
