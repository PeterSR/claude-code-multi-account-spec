{
  "id": "b3-default-account",
  "description": "default sessions live in ~/.claude/sessions",
  "spec": [
    "B3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude/sessions/7.json": {
      "type": "file",
      "content": "{\"pid\": 7, \"sessionId\": \"s-7\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    }
  },
  "processes": {
    "7": {
      "procStart": "T1",
      "pidDomain": "host-1"
    }
  },
  "op": {
    "name": "live_sessions",
    "args": {
      "name": "default"
    }
  },
  "expect": {
    "result": {
      "sessions": [
        {
          "pid": 7,
          "sessionId": "s-7",
          "status": "live"
        }
      ]
    }
  }
}
