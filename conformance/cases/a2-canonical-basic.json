{
  "id": "a2-canonical-basic",
  "description": "canonical path of a named account on linux",
  "spec": [
    "A2 Canonical path"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "canonical_path",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "path": "/home/p/.claude-work"
    }
  }
}
