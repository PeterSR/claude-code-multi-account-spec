{
  "id": "b7-adopt-credentials-link-refused",
  "description": "a linked .credentials.json would make the slot broken",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude/.credentials.json": {
      "type": "symlink",
      "target": "/data/c"
    },
    "/data/c": {
      "type": "file",
      "content": "c"
    }
  },
  "op": {
    "name": "adopt",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "error": {
      "code": "SLOT_TARGET_INVALID",
      "path": "/home/p/.claude/.credentials.json"
    }
  },
  "expectFs": {
    "/home/p/.claude-work": null
  }
}
