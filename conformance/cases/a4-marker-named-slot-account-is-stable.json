{
  "id": "a4-marker-named-slot-account-is-stable",
  "description": "a marker naming the slot account gets its own config dir, not default",
  "spec": [
    "A2 Relocation",
    "A4 Step 2.1"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p/proj",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/proj/.claude-account": {
      "type": "file",
      "content": "work\n"
    }
  },
  "op": {
    "name": "resolve",
    "args": {}
  },
  "expect": {
    "result": {
      "account": "work",
      "pool": null,
      "configDir": "/home/p/.claude-work",
      "canonical": true,
      "reason": null,
      "source": "marker-file",
      "matchedPath": "/home/p/proj/.claude-account",
      "exists": true,
      "aliasOf": null,
      "launchEnv": {
        "set": {
          "CLAUDE_CONFIG_DIR": "/home/p/.claude-work",
          "CLAUDE_MULTI_ACCOUNT": "work"
        },
        "unset": [
          "CLAUDE_MULTI_ACCOUNT_SOURCE",
          "CLAUDE_SECURESTORAGE_CONFIG_DIR"
        ]
      },
      "overriddenBy": [],
      "ignoredMarkers": [],
      "warnings": [],
      "applied": true,
      "candidates": [
        "work"
      ],
      "globalConfig": "/home/p/.claude-work/.claude.json"
    }
  }
}
