{
  "id": "b5-mark-dangling-state-link-is-fresh",
  "description": "a link whose target is missing counts as no file and is written through",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "symlink",
      "target": "/data/state.json"
    },
    "/data": {
      "type": "dir"
    }
  },
  "op": {
    "name": "mark_limited",
    "args": {
      "name": "work",
      "entry": {
        "window": "seven_day",
        "model": "opus",
        "until": "2026-10-09T14:00:00Z",
        "reason": "rate_limit",
        "updatedBy": "my-swapper"
      }
    }
  },
  "expect": {
    "result": {
      "limits": [
        {
          "window": "seven_day",
          "model": "opus",
          "until": "2026-10-09T14:00:00Z",
          "reason": "rate_limit",
          "updatedBy": "my-swapper",
          "updatedAt": "2026-10-06T12:00:00Z"
        }
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account-state.json": {
      "type": "symlink"
    },
    "/data/state.json": {
      "type": "file",
      "contentJson": {
        "version": 1,
        "limits": [
          {
            "window": "seven_day",
            "model": "opus",
            "until": "2026-10-09T14:00:00Z",
            "reason": "rate_limit",
            "updatedBy": "my-swapper",
            "updatedAt": "2026-10-06T12:00:00Z"
          }
        ]
      }
    }
  }
}
