{
  "id": "a2-discover-junction-win32",
  "description": "win32 junction to a directory is an account",
  "spec": [
    "A2 Relocation"
  ],
  "platform": "win32",
  "caseInsensitive": true,
  "home": "C:\\Users\\p",
  "cwd": "C:\\Users\\p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "C:\\Users\\p": {
      "type": "dir"
    },
    "C:\\Users\\p\\.claude-work": {
      "type": "junction",
      "target": "D:\\data\\work"
    },
    "D:\\data\\work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "discover",
    "args": {}
  },
  "expect": {
    "result": {
      "accounts": [
        {
          "name": "default",
          "configDir": "C:\\Users\\p\\.claude",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        },
        {
          "name": "work",
          "configDir": "C:\\Users\\p\\.claude-work",
          "state": "ok",
          "hasSpecFile": false,
          "hasGlobalConfig": false,
          "aliasOf": null,
          "specError": null,
          "warnings": []
        }
      ],
      "conflicts": [],
      "warnings": []
    }
  }
}
