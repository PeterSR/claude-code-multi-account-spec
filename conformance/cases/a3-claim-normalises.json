{
  "id": "a3-claim-normalises",
  "description": "the directory is lexically normalised first",
  "spec": [
    "A3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/.multi-account.json": {
      "type": "file",
      "content": "{\"version\": 1}"
    }
  },
  "op": {
    "name": "claim",
    "args": {
      "name": "work",
      "dir": "/home/p/dev/../dev//x/"
    }
  },
  "expect": {
    "result": {
      "directories": [
        "~/dev/x"
      ]
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account.json": {
      "contentJson": {
        "version": 1,
        "directories": [
          "~/dev/x"
        ]
      }
    }
  }
}
