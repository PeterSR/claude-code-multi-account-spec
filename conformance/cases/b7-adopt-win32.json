{
  "id": "b7-adopt-win32",
  "description": "win32 adopt creates a junction for the directory and a file symlink",
  "spec": [
    "B7"
  ],
  "platform": "win32",
  "caseInsensitive": true,
  "home": "C:\\Users\\p",
  "cwd": "C:\\Users\\p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "C:\\Users\\p": {
      "type": "dir"
    },
    "C:\\Users\\p\\.claude": {
      "type": "dir"
    },
    "C:\\Users\\p\\.claude\\.credentials.json": {
      "type": "file",
      "content": "cred"
    },
    "C:\\Users\\p\\.claude.json": {
      "type": "file",
      "content": "{\"a\":1}"
    }
  },
  "op": {
    "name": "adopt",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "state": "managed",
      "name": "work"
    }
  },
  "expectFs": {
    "C:\\Users\\p\\.claude": {
      "type": "junction",
      "target": "C:\\Users\\p\\.claude-work"
    },
    "C:\\Users\\p\\.claude.json": {
      "type": "symlink",
      "target": "C:\\Users\\p\\.claude-work\\.claude.json"
    },
    "C:\\Users\\p\\.claude-work\\.credentials.json": {
      "type": "file",
      "content": "cred"
    },
    "C:\\Users\\p\\.claude-work\\.claude.json": {
      "type": "file",
      "content": "{\"a\":1}"
    }
  }
}
