{
  "id": "b4-handover-source-linked-tasks-dir-skipped",
  "description": "a linked tasks directory is skipped as a whole",
  "spec": [
    "B4"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-a": {
      "type": "dir"
    },
    "/home/p/.claude-b": {
      "type": "dir"
    },
    "/home/p/.claude-a/file-history/sess-1/v1": {
      "type": "file",
      "content": "h"
    },
    "/home/p/.claude-a/tasks": {
      "type": "symlink",
      "target": "/data/t"
    },
    "/data/t/sess-1/t.json": {
      "type": "file",
      "content": "{}"
    }
  },
  "op": {
    "name": "handover_session",
    "args": {
      "id": "sess-1",
      "from": "a",
      "to": "b"
    }
  },
  "expect": {
    "result": {
      "copied": [
        "file-history/sess-1/v1"
      ],
      "skipped": [
