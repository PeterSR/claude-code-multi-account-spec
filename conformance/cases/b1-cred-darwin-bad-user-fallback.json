{
  "id": "b1-cred-darwin-bad-user-fallback",
  "description": "user name failing the pattern becomes claude-code-user",
  "spec": [
    "B1",
    "A1",
    "A2 Canonical path"
  ],
  "platform": "darwin",
  "caseInsensitive": true,
  "home": "/Users/p",
  "cwd": "/Users/p",
  "env": {
    "USER": "bad user"
  },
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/Users/p": {
      "type": "dir"
    }
  },
  "op": {
    "name": "credential_locations",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "locations": [
        {
          "keychain": {
            "service": "Claude Code-credentials-959cec09",
            "account": "claude-code-user"
          }
        },
        {
          "file": "/Users/p/.claude-work/.credentials.json"
        }
      ]
    }
  }
}
