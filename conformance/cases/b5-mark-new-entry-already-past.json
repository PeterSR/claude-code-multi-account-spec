{
  "id": "b5-mark-new-entry-already-past",
  "description": "a new entry that is already past is dropped",
  "spec": [
    "B5"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "mark_limited",
    "args": {
      "name": "work",
      "entry": {
        "window": "seven_day",
        "model": "opus",
        "until": "2026-10-06T11:59:59Z",
        "reason": "rate_limit",
        "updatedBy": "my-swapper"
      }
    }
  },
  "expect": {
    "result": {
      "limits": []
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.multi-account-state.json": {
      "contentJson": {
        "version": 1,
        "limits": []
      }
    }
  }
}
