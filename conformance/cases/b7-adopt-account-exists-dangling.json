{
  "id": "b7-adopt-account-exists-dangling",
  "description": "a dangling link in the way counts as existing",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "dir"
    },
    "/home/p/.claude/.credentials.json": {
      "type": "file",
      "content": "cred"
    },
    "/home/p/.claude.json": {
      "type": "file",
      "content": "{\"a\":1}"
    },
    "/home/p/.claude-work": {
      "type": "symlink",
      "target": "/mnt/gone"
    }
  },
  "op": {
    "name": "adopt",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "error": {
      "code": "ACCOUNT_EXISTS",
      "path": "/home/p/.claude-work"
    }
  }
}
