{
  "id": "a2-create-exists-case-variant-ci",
  "description": "case-insensitive fs: .claude-Work blocks create(work)",
  "spec": [
    "A2 Create"
  ],
  "platform": "darwin",
  "caseInsensitive": true,
  "home": "/Users/p",
  "cwd": "/Users/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/Users/p": {
      "type": "dir"
    },
    "/Users/p/.claude-Work": {
      "type": "dir"
    }
  },
  "op": {
    "name": "create",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "error": {
      "code": "ACCOUNT_EXISTS",
      "path": "/Users/p/.claude-work"
    }
  }
}
