{
  "id": "b3-ignores-odd-files",
  "description": "only <digits>.json files that parse to objects count",
  "spec": [
    "B3"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude-work/sessions/5.json": {
      "type": "file",
      "content": "{\"pid\": 5, \"sessionId\": \"s-5\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    },
    "/home/p/.claude-work/sessions/abc.json": {
      "type": "file",
      "content": "{\"pid\": 6, \"sessionId\": \"s-6\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    },
    "/home/p/.claude-work/sessions/7.json.bak": {
      "type": "file",
      "content": "{\"pid\": 7, \"sessionId\": \"s-7\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    },
    "/home/p/.claude-work/sessions/x8.json": {
      "type": "file",
      "content": "{\"pid\": 8, \"sessionId\": \"s-8\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    },
    "/home/p/.claude-work/sessions/9.txt": {
      "type": "file",
      "content": "{\"pid\": 9, \"sessionId\": \"s-9\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    },
    "/home/p/.claude-work/sessions/11.json": {
      "type": "file",
      "content": "{bad"
    },
    "/home/p/.claude-work/sessions/12.json": {
      "type": "file",
      "content": "[1]"
    }
  },
  "processes": {},
  "op": {
    "name": "live_sessions",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "sessions": [
        {
          "pid": 5,
          "sessionId": "s-5",
          "status": "dead"
        }
      ]
    }
  }
}
