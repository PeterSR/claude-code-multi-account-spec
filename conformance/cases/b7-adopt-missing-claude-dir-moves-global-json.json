{
  "id": "b7-adopt-missing-claude-dir-moves-global-json",
  "description": "no ~/.claude but a ~/.claude.json: the file is moved in",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude.json": {
      "type": "file",
      "content": "{\"a\":1}"
    }
  },
  "op": {
    "name": "adopt",
    "args": {
      "name": "work"
    }
  },
  "expect": {
    "result": {
      "state": "managed",
      "name": "work"
    }
  },
  "expectFs": {
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{\"a\":1}"
    }
  }
}
