{
  "id": "b7-activate-live-not-forceable",
  "description": "force never overrides a live session",
  "spec": [
    "B7"
  ],
  "platform": "linux",
  "caseInsensitive": false,
  "home": "/home/p",
  "cwd": "/home/p",
  "env": {},
  "options": {},
  "now": "2026-10-06T12:00:00Z",
  "fs": {
    "/home/p": {
      "type": "dir"
    },
    "/home/p/.claude": {
      "type": "symlink",
      "target": "/home/p/.claude-work"
    },
    "/home/p/.claude.json": {
      "type": "symlink",
      "target": "/home/p/.claude-work/.claude.json"
    },
    "/home/p/.claude-work": {
      "type": "dir"
    },
    "/home/p/.claude-work/.claude.json": {
      "type": "file",
      "content": "{}"
    },
    "/home/p/.claude-personal/.claude.json": {
      "type": "file",
      "content": "{\"p\":1}"
    },
    "/home/p/.claude-personal/.credentials.json": {
      "type": "file",
      "content": "pc"
    },
    "/home/p/.claude-work/.credentials.json": {
      "type": "file",
      "content": "wc"
    },
    "/home/p/.claude-work/sessions/300.json": {
      "type": "file",
      "content": "{\"pid\": 300, \"sessionId\": \"s-300\", \"procStart\": \"T1\", \"pidDomain\": \"host-1\"}"
    }
  },
  "processes": {
    "300": {
      "procStart": "T1",
      "pidDomain": "host-1"
    }
  },
  "op": {
    "name": "activate",
    "args": {
      "name": "personal",
      "force": true
    }
  },
  "expect": {
    "error": {
      "code": "SESSION_LIVE",
      "path": null
    }
  }
}
